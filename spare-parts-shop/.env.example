
# Server
PORT=8080

# Database (Supabase or Render PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://your-supabase-host:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-supabase-password
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# File Uploads
APP_UPLOAD_DIR=uploads
APP_BACKUP_DIR=backups

# CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend-url.com

# Email (optional)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password
